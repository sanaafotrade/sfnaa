generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
}

model EmailRecord {
  id          String   @id @default(cuid())
  to          String
  from        String
  subject     String?
  text        String?
  html        String?
  attachments Json?    // Stores array of attachment objects
  
  // Status flags
  status      String   @default("inbox") // "inbox", "spam", "deleted"
  isRead      Boolean  @default(false)
  isStarred   Boolean  @default(false)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EmailSettings {
  id                 String   @id @default("default")
  
  signature          String   @default("")
  senderName         String   @default("Safana Najd")
  signatureEnabled   Boolean  @default(false)
  
  autoReplyEnabled   Boolean  @default(false)
  autoReplySubject   String   @default("شكراً لتواصلك - مؤسسة سفانة نجد")
  autoReplyBody      String   @default("تم استلام رسالتك بنجاح. سنقوم بالرد عليك في أقرب وقت.")
  autoReplyTeamName  String   @default("فريق سفانة نجد")
  
  trustedEmails      String[] @default([])
  blockedEmails      String[] @default([])
  
  updatedAt          DateTime @updatedAt
}

model Service {
  id          String   @id @default(cuid())
  titleAr     String
  titleEn     String
  descAr      String
  descEn      String
  icon        String   @default("Globe")
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Partner {
  id          String   @id @default(cuid())
  name        String
  logoUrl     String?
  websiteUrl  String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteSettings {
  id              String   @id @default("default")
  heroTitleAr     String   @default("نربط العالم بصناعتك")
  heroTitleEn     String   @default("Connecting the World to Your Industry")
  heroDescAr      String   @default("سفانة نجد للتجارة، شريكك الموثوق في استيراد وتصدير المواد الخام وتوريد البلاستيك بأعلى معايير الجودة العالمية.")
  heroDescEn      String   @default("Safana Najd Trading, your trusted partner in importing and exporting raw materials and supplying plastics with the highest global quality standards.")
  aboutTitleAr    String   @default("من نحن")
  aboutTitleEn    String   @default("About Us")
  aboutDescAr     String   @default("نحن في سفانة نجد للتجارة نعتز بخبرتنا العميقة في مجال التجارة الدولية. تخصصنا الأساسي هو توفير أفضل المواد الخام اللازمة للصناعات المختلفة، مع التركيز بشكل خاص على قطاع البلاستيك.")
  aboutDescEn     String   @default("At Safana Najd Trading, we pride ourselves on our deep expertise in international trade. Our core specialty is providing the best raw materials for various industries, with a special focus on the plastics sector.")
  contactEmail    String   @default("info@sfnaa.com")
  contactPhone    String   @default("+966 50 000 0000")
  contactAddress  String   @default("الرياض، المملكة العربية السعودية")
  statsClients    String   @default("+50")
  statsYears      String   @default("+15")
  statsCountries  String   @default("+10")
  updatedAt       DateTime @updatedAt
}

model User {
  id               String    @id @default(cuid())
  name             String
  email            String    @unique
  phone            String?   @unique
  password         String    // Hashed password
  role             String    @default("EMPLOYEE") // "OWNER", "MANAGER", "EMPLOYEE"
  permissions      String[]  @default([]) // e.g. ["email", "settings", "services", "partners", "users"]
  isActive         Boolean   @default(true)
  resetToken       String?   @unique
  resetTokenExpiry DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Letter {
  id                String   @id @default(cuid())
  title             String
  letterNumber      String?
  type              String   // "outgoing" | "incoming" | "internal"
  fileUrl           String
  fileType          String   // "pdf" | "image"
  stampApplied      Boolean  @default(false)
  signatureApplied  Boolean  @default(false)
  finalFileUrl      String?
  relatedEmployeeId String?
  notes             String?
  createdBy         String
  createdByName     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  updatedBy         String?
  updatedByName     String?
}

model OrgStamp {
  id           String   @id @default(cuid())
  name         String
  imageDataUrl String
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model SavedSignature {
  id               String   @id @default(cuid())
  name             String
  signatureDataUrl String
  isDefault        Boolean  @default(false)
  createdAt        DateTime @default(now())
}

model LetterDocument {
  id              String   @id @default(cuid())
  language        String   @default("ar")
  letterNumber    String?
  dateGregorian   String?
  dateHijri       String?
  showRecipient   Boolean  @default(true)
  recipientText   String?
  showSubject     Boolean  @default(true)
  subjectText     String?
  showGreeting    Boolean  @default(true)
  blocks          Json?
  showClosing     Boolean  @default(true)
  closingText     String?
  signerName      String?
  signerTitle     String?
  signerX         Float?
  signerY         Float?
  signatureUrl    String?
  signatureX      Float?
  signatureY      Float?
  signatureWidth  Float?
  signatureHeight Float?
  signaturePage   Int?
  stampUrl        String?
  stampX          Float?
  stampY          Float?
  stampWidth      Float?
  stampHeight     Float?
  stampPage       Int?
  overlays        Json?
  status          String   @default("draft")
  createdBy       String?
  updatedBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model LetterTemplateSettings {
  id                  String   @id @default("default")
  companyNameAr       String?
  companyNameEn       String?
  companyLogoUrl      String?
  crNumber            String?
  vatNumber           String?
  phone               String?
  email               String?
  website             String?
  footerAddressAr     String?
  footerAddressEn     String?
  defaultSignatureUrl String?
  defaultStampUrl     String?
  updatedAt           DateTime @updatedAt
}
